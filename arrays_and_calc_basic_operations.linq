<Query Kind="Program" />

void Main()
{
	int[] nums = {78, 72, 50, 5};
	
	// sum
	
	Console.WriteLine("Result 1: \n ");
	int op_1 = nums[0] + nums[1];
	Console.WriteLine(op_1);
	// rest
	Console.WriteLine("Result 2: \n ");
	int op_2 = nums[0] - nums[1];
	Console.WriteLine(op_2);
	// div
	Console.WriteLine("Result 3: \n ");
	int op_3 = nums[0] / nums[1];
	Console.WriteLine(op_3);
	// multiplication
	Console.WriteLine("Result 4: \n ");
	int op_4 = nums[0] * nums[1];
	Console.WriteLine(op_4);
	
}

